{
  "name": "vercio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Vercio — local-first, Vercel-style frontend collaboration. Point at a repo, preview any branch on your LAN.",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "vite build",
    "start": "node server/index.js",
    "server": "node server/index.js",
    "test": "node --test --test-concurrency=1 tests/*.test.js",
    "typecheck": "tsc --noEmit",
    "demo": "node scripts/seed-demo.mjs",
    "start:open": "node server/index.js --open"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "dependencies": {
    "@fontsource-variable/geist": "5.3.0",
    "@fontsource-variable/geist-mono": "5.3.0",
    "dompurify": "3.4.18",
    "lucide-react": "1.74.0",
    "marked": "18.2.1",
    "qrcode": "1.5.4",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@vitejs/plugin-react": "6.3.0",
    "typescript": "5.9.3",
    "vite": "8.3.8"
  }
}
